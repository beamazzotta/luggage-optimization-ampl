# 2. ANALISI CAPACITA PUNTO
let capacita ["Punto"] := 170; solve; printf "Scenario 2A (Cap. 170)", Profitto, y;
let capacita ["Punto"] := 80;  solve; printf "Scenario 2B (Cap. 80)", Profitto, y;
let capacita ["Punto"] := 140; # Ripristino finale

